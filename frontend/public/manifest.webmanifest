{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "Movies Center - Watch Movies & TV Series",
  "short_name": "MoviesCenter",
  "description": "Stream your favorite movies and TV series in high definition. Fast, clean, and modern streaming platform.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0a0b10",
  "theme_color": "#e50914",
  "categories": ["entertainment", "movies", "video"],
  "icons": [
    {
      "src": "icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Explore Movies",
      "short_name": "Movies",
      "description": "Browse the latest and trending movies",
      "url": "/movies",
      "icons": [{ "src": "icons/icon-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "Explore TV Series",
      "short_name": "Series",
      "description": "Discover popular TV shows and seasons",
      "url": "/series",
      "icons": [{ "src": "icons/icon-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "My Watchlist",
      "short_name": "Watchlist",
      "description": "Access your saved movies and series",
      "url": "/watchlist",
      "icons": [{ "src": "icons/icon-192x192.png", "sizes": "192x192" }]
    }
  ]
}
