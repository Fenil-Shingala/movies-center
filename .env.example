# ==============================================================================
# Movies Center - Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# NEVER commit .env to version control.
# ==============================================================================

# Database & Cache
DATABASE_CONNECTION_STRING=Server=localhost,1433;Database=MoviesCenterDb;User Id=sa;Password=Your_Strong_Password_123!;TrustServerCertificate=True
REDIS_CONNECTION_STRING=localhost:6379

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_string_at_least_64_characters_long_for_security_123456
JWT_ISSUER=https://localhost:5001
JWT_AUDIENCE=http://localhost:4200

# TMDB (The Movie Database) API
TMDB_API_KEY=4afe98c4e5ae2c05958c237fb4dca934
TMDB_ACCESS_TOKEN=

# Initial Administrator Seed Credentials
ADMIN_EMAIL=admin.movies@gmail.com
ADMIN_PASSWORD=Admin#movies@123

# Transactional Email (Postmark)
POSTMARK_API_KEY=
POSTMARK_FROM_EMAIL=noreply@moviescenter.com

# Web Push Notifications (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin.movies@gmail.com

# Video Storage & Transcoding (Bunny Stream)
BUNNY_API_KEY=
BUNNY_LIBRARY_ID=
BUNNY_WEBHOOK_SECRET=

# Bot Protection (hCaptcha)
HCAPTCHA_SECRET_KEY=
HCAPTCHA_SITE_KEY=

# Product Analytics (PostHog)
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# CORS & Security
CORS_ORIGINS=http://localhost:4200,https://localhost:5001
ALLOWED_FRAME_SOURCES=vidsrc.to
